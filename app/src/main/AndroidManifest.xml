<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is used in two places: redeeming a supporter code, which
         sends the hash of the code and a random id for this installation to
         the activation server and gets back a signed token (core's
         Activation.kt, PLAN_SUPPORTER_SERVER.md), and the update check, one
         GET to GitHub's releases list when the app is opened (core's
         Updates.kt). `NetworkTest` holds the five permissions by name and
         those two files as the only ones that may open a connection.
         It is a normal permission, so there is no runtime dialog and the
         onboarding stays at three asks. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- What the launcher can start, so the game's package can be found by
         ldplayer.py's rule without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DigiAutotapApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/DigiAutotap"
        android:allowBackup="false">

        <!-- Portrait only: the game is portrait, and an app page that turns
             with the phone has nothing to gain from it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The service the player switches on: the capture, tap and back. -->
        <service
            android:name=".DigiAutotapService"
            android:exported="true"
            android:label="@string/service_label_main"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/digiautotap_accessibility" />
        </service>

        <!-- The core's home. Of Android 14's types only mediaProjection is
             about the screen, and it needs a MediaProjection token that an
             accessibility screenshot does not use; specialUse, with the
             reason written down, is the documented answer. -->
        <service
            android:name=".CoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the game helper running while the player is in the game: it reads the screen through the app's accessibility service and shows its main switch in this notification." />
        </service>

        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />

        <provider
            android:name=".ShareProvider"
            android:authorities="io.github.digipr1me.digiautotap.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The spike: no overlay, no notification, no onboarding.
             Granted by hand, or with "adb shell settings put secure
             enabled_accessibility_services". -->
        <service
            android:name=".SpikeService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
